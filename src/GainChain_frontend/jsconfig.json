{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"]
      },
      "checkJs": true
    },
    "include": [
      "src/**/*.js",
      "src/**/*.jsx"
    ],
    "exclude": [
      "node_modules",
      "**/*.spec.js"
    ]
}
  